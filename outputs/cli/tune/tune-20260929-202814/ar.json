      "text": "```python\n    cases: list[PromptCase] = []\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite file not found: {path}\")\n    with path.open(\"r\", encoding=\"utf-8\") as f:\n        for line_num, line in enumerate(f, start=1):\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                data = json.loads(line)\n            except json.JSONDecodeError as e:\n                raise ValueError(f\"Invalid JSON on line {line_num}: {e}\") from e\n            required = {\"id\", \"category\", \"prompt\"}\n            missing = required - set(data.keys())\n            if missing:\n                raise ValueError(f\"Missing required fields on line {line_num}: {missing}\")\n            case = PromptCase(\n                id=data[\"id\"],\n                category=data[\"category\"],\n                prompt=data[\"prompt\"],\n                max_tokens=data.get(\"max_tokens\", 128),\n                notes=data.get(\"notes\", \"\"),\n            )\n            cases.append(case)\n    return cases\n\n\ndef validate_prompt_suite(cases: list[PromptCase]) -> list[str]:\n    \"\"\"Validate prompt cases and return list of errors. Empty list means valid.\"\"\"\n    errors: list[str] = []\n    seen_ids: set[str] = set()\n    for case in cases:\n        if case.id in seen_ids:\n            errors.append(f\"Duplicate case id: {case.id}\")\n        seen_ids.add(case.id)\n        if case.max_tokens < 1:\n            errors.append(f\"Case {case.id}: max_tokens must be >= 1, got {case.max_tokens}\")\n        if not case.category.strip():\n            errors.append(f\"Case {case.id}: category cannot be empty\")\n        if not case.prompt.strip():\n            errors.append(f\"Case {case.id}: prompt cannot be empty\")\n    return errors\n\n\ndef prompt_sha256_map(cases: list[PromptCase]) -> dict[str, str]:\n    \"\"\"Return mapping of case id to prompt SHA256.\"\"\"\n    return {case.id: case.prompt_sha256 for case in cases}\n\n\ndef case_by_id(cases: list[PromptCase], case_id: str) -> PromptCase | None:\n    \"\"\"Find first case matching the given ID.\"\"\"\n    for case in cases:\n",
