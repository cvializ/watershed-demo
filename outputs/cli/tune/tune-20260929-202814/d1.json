sure_ascii=False) + \"\\n\")\n\n\ndef validate_prompt_cases(cases: list[PromptCase]) -> None:\n    \"\"\"Validate that all prompt cases have unique IDs and valid fields.\"\"\"\n    seen_ids: set[str] = set()\n    for case in cases:\n        if case.id in seen_ids:\n            raise ValueError",
