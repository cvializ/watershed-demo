          "text": "```python\nimport hashlib\nimport json\nfrom dataclasses import asdict, dataclass\nfrom pathlib import Path\nfrom typing import Any, Iterable\n\n\n@dataclass(frozen=True)\nclass PromptCase:\n    id: str\n    category: str\n    prompt: str\n    max_tokens: int = 128\n    notes: str = \"\"\n\n    @property\n    def prompt_sha256(self) -> str:\n        return hashlib.sha256(self.prompt.encode(\"utf-8\")).hexdigest()\n\n\ndef load_prompt_suite(path: Path) -> list[PromptCase]:\n    \"\"\"Load a JSONL prompt suite and validate required fields.\"\"\"\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite file not found: {path}\")\n    cases: list[PromptCase] = []\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        for line_no, line in enumerate(f, 1):\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                data: dict[str, Any] = json.loads(line)\n            except json.JSONDecodeError as e:\n                raise ValueError(f\"Invalid JSON on line {line_no}: {e}\")\n            required = {\"id\", \"category\", \"prompt\"}\n            missing = required - data.keys()\n            if missing:\n                raise ValueError(f\"Missing required fields {missing} on line {line_no}\")\n            case = PromptCase(\n                id=str(data[\"id\"]),\n                category=str(data[\"category\"]),\n                prompt=str(data[\"prompt\"]),\n                max_tokens=int(data.get(\"max_tokens\", 128)),\n                notes=str(data.get(\"notes\", \"\")),\n            )\n            cases.append(case)\n    return cases\n\n\ndef write_prompt_suite(path: Path, cases: Iterable[PromptCase]) -> None:\n    \"\"\"Write prompt cases to a JSONL file.\"\"\"\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        for case in cases:\n            data = asdict(case)\n            f.write(json.dumps(data, ensure_ascii=False) + \"\\n\")\n\n\ndef deduplicate_cases(cases: list[PromptCase]) -> list[PromptCase]:\n    \"\"\"Return unique cases by prompt hash, preserving first occurrence.\"\"\"\n    seen: set[str] = set()\n    unique: list[Prompt",
