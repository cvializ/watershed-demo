{
  "name": "myapp",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "call-hierarchy": "./bin/call-hierarchy"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "playwright test",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint": "oxlint . && npm run lint:underscore-check && npm run lint:unique-exports && npm run lint:async-imports",
    "lint:underscore-check": "tsx scripts/constraints/check-underscore-vars.ts",
    "lint:unique-exports": "tsx scripts/constraints/check-unique-exports.ts",
    "lint:async-imports": "tsx scripts/constraints/check-async-imports.ts",
    "format": "oxfmt --check",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "pre-commit": "npm run validate && npm run knip && npm run format"
  },
  "dependencies": {
    "bitecs": "^0.4.0",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/pino": "^7.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "knip": "^6.23.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^0.15.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
